# Copy to .env and fill values.

# Required for signing magic links + sessions
JWT_SECRET=replace-with-a-long-random-string

# Comma-separated list of allowed admin emails
ADMIN_EMAILS=muhammadsaifudinmj@gmail.com

# Where the email link should point (your backend URL)
# Example (dev): http://localhost:5174
PUBLIC_BASE_URL=http://localhost:5174

# CORS allowed origin(s)
# Use ONE of these:
# - CORS_ORIGIN=http://localhost:5174
# - CORS_ORIGINS=http://localhost:5174,http://localhost:5173
CORS_ORIGIN=http://localhost:5174
# CORS_ORIGINS=

# Optional SMTP (if omitted, magic link is printed to the server console)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Iamatto Web Catalog <no-reply@example.com>

# Gmail SMTP example (recommended: use Google "App Password")
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=yourgmail@gmail.com
# SMTP_PASS=xxxx xxxx xxxx xxxx
# SMTP_FROM=Iamatto Web Catalog <yourgmail@gmail.com>

# Optional Turso (if set, catalogue/config are stored in Turso instead of local JSON files)
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Hugging Face API for Website Generator
# Get from: https://huggingface.co/settings/tokens
HUGGING_FACE_API_KEY=hf_xxxxx
# Optional: comma-separated fallback models to try in order
HUGGING_FACE_MODELS=Qwen/Qwen2.5-72B-Instruct,Qwen/Qwen2.5-32B-Instruct,meta-llama/Llama-3.1-8B-Instruct

# GitHub Token for auto-committing approved websites (optional)
# Get from: https://github.com/settings/tokens
GITHUB_TOKEN=ghp_xxxxx

